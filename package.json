{
  "name": "easy-ponto",
  "version": "1.0.0",
  "description": "Aplicação completa para controle de ponto e organização de jornadas de trabalho",
  "keywords": [
    "controle-de-ponto",
    "nextjs"
  ],
  "author": "João Vitor Dias",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "services:up": "docker compose -f src/infra/compose.yaml up -d",
    "services:stop": "docker compose -f src/infra/compose.yaml stop",
    "services:down": "docker compose -f src/infra/compose.yaml down",
    "db:migrate": "exec prisma migrate dev",
    "db:generate": "exec prisma generate",
    "db:reset": "exec prisma migrate reset",
    "db:studio": "exec prisma studio",
    "test:integration": "vitest --no-file-parallelism --run",
    "test:integration:watch": "vitest --no-file-parallelism",
    "test:e2e": "exec playwright test",
    "test:e2e:ui": "exec playwright test --ui",
    "test:all": "concurrently \"pnpm test:integration\" \"pnpm test:e2e\"",
    "eslint:check": "eslint .",
    "eslint:fix": "eslint --fix .",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "shadcn:add": "pnpm dlx shadcn@latest add",
    "prepare": "husky",
    "postinstall": "exec prisma generate"
  },
  "dependencies": {
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.18",
    "lucide-react": "0.545.0",
    "next": "15.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "svg-dotted-map": "2.0.1",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@eslint/compat": "1.4.0",
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.37.0",
    "@playwright/test": "^1.56.1",
    "@prisma/client": "6.17.0",
    "@prisma/extension-accelerate": "2.0.2",
    "@tailwindcss/postcss": "4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.7.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "commitlint-config-emoji-convention": "1.0.3",
    "concurrently": "9.2.1",
    "dotenv": "17.2.3",
    "eslint": "9.37.0",
    "eslint-config-next": "15.5.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "husky": "9.1.7",
    "jsdom": "27.0.0",
    "lint-staged": "16.2.3",
    "prettier": "3.6.2",
    "prisma": "6.17.0",
    "tailwindcss": "4",
    "tsx": "4.20.6",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.17.1"
}
