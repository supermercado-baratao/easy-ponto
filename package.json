{
  "name": "easy-ponto",
  "version": "1.0.0",
  "description": "Aplicação completa para controle de ponto e organização de jornadas de trabalho",
  "repository": "https://github.com/supermercado-baratao/easy-ponto.git",
  "author": "João Vitor <jvitordiass@outlook.com.br>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm services:up && pnpm services:wait:database && pnpm migrations:up && next dev",
    "build": "next build",
    "start": "next start",
    "services:up": "docker compose -f src/infra/compose.yml up -d",
    "services:stop": "docker compose -f src/infra/compose.yml stop",
    "services:down": "docker compose -f src/infra/compose.yml down",
    "services:wait:database": "node src/infra/scripts/wait-for-database.ts",
    "migrations:generate": "prisma contract emit && prisma migration plan --name",
    "migrations:up": "prisma db migrate --advance-ref db --no-interactive",
    "test": "vitest --run --project unit --passWithNoTests",
    "test:watch": "vitest --project unit --passWithNoTests",
    "test:services": "pnpm services:up && set -a && . ./.env.test && set +a && pnpm services:wait:database && pnpm migrations:up",
    "test:integration": "pnpm test:services && vitest --run --project integration",
    "test:external": "pnpm test:services && vitest --run --project external",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:mocks:create": "tsx src/tests/_mocks/scripts/create-fake-data.ts",
    "type-check": "next typegen && tsc --noEmit",
    "eslint:check": "eslint .",
    "eslint:fix": "eslint --fix .",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "shadcn:add": "pnpm dlx shadcn@latest add",
    "prepare": "husky",
    "postinstall": "prisma contract emit",
    "database:generate": "prisma contract emit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@prisma/orm-postgres": "8.0.0-rc.22",
    "axios": "1.21.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "dayjs": "1.11.23",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "svg-dotted-map": "2.1.0",
    "validation-br": "2.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@eslint/json": "2.1.1",
    "@eslint/markdown": "8.0.3",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/async-retry": "1.4.9",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "async-retry": "1.3.3",
    "babel-plugin-react-compiler": "1.0.0",
    "commitlint-config-emoji-convention": "1.0.3",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prefer-arrow-functions": "3.10.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "eslint-plugin-unicorn": "79.0.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "ora": "9.4.1",
    "prettier": "3.9.10",
    "prisma": "8.0.0-rc.30",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.16.0",
  "engines": {
    "node": "24.x"
  }
}
