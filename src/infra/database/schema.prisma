// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id String @id @default(uuid())

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  deviceCredentialsId String?
  deviceCredentials   DeviceCredentials? @relation(fields: [deviceCredentialsId], references: [id])

  user User?

  @@map("admin_users")
}

model DeviceCredentials {
  id       String @id @default(uuid())
  ip       String
  login    String
  password String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  adminUsers    AdminUser[]
  deviceSession DeviceSession?

  @@map("devices_credentials")
}

model DeviceSession {
  id    String @id @default(uuid())
  token String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deviceCredentialsId String            @unique
  deviceCredentials   DeviceCredentials @relation(fields: [deviceCredentialsId], references: [id])

  @@map("devices_sessions")
}

model Company {
  id      String @id @default(uuid())
  name    String
  address String
  cpf     String
  tipoDoc Int    @map("tipo_doc")
  cpfCnpj String @unique @map("cpf_cnpj")
  cei     String

  registration String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  adminUsers AdminUser[]
  users      User[]

  @@map("companies")
}

model User {
  id             String  @id @default(uuid())
  name           String
  pis            String  @unique
  cpf            String?
  code           String
  templatesCount Int     @map("templates_count")
  password       String
  rfid           String
  bars           String
  registration   String

  payrollNumber String?   @map("payroll_number")
  admissionDate DateTime? @map("admission_date")
  position      String?
  department    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  adminUserId String?    @unique @map("admin_user_id")
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])

  punchRecords PunchRecord[]

  @@map("users")
}

model PunchRecord {
  id       String   @id @default(uuid())
  pis      String
  datetime DateTime

  afdDatetime           DateTime? @map("afd_datetime")
  nsr                   Int?      @unique
  registrationType      String?   @map("registration_type")
  hexadecimalCheckDigit String?   @map("hexadecimal_check_digit")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [pis], references: [pis])

  @@map("punch_records")
}
