        "name": "rest_restrictions_kind_check",
        "value": "(\"kind\" = 'together' and \"max_off\" >= 1 and \"user_group_id\" is null and \"user_id\" is null)\n        or (\"kind\" = 'group' and \"max_off\" >= 1 and \"user_group_id\" is not null and \"user_id\" is null)\n        or (\"kind\" = 'weekdays' and \"max_off\" is null and \"user_group_id\" is null and \"user_id\" is not null and cardinality(\"weekdays\") between 1 and 6)",
