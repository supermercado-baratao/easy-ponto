// use prisma-8

model AdminUser {
  id String @id @onCreate(uuid())

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @onCreate(now()) @onUpdate(now()) @map("updated_at")

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  deviceCredentialsId String?
  deviceCredentials   DeviceCredentials? @relation(fields: [deviceCredentialsId], references: [id])

  user User?

  @@map("admin_users")
}

model DeviceCredentials {
  id       String @id @onCreate(uuid())
  ip       String
  login    String
  password String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @onCreate(now()) @onUpdate(now()) @map("updated_at")

  adminUsers    AdminUser[]
  deviceSession DeviceSession?

  @@map("devices_credentials")
}

model DeviceSession {
  id    String @id @onCreate(uuid())
  token String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @onCreate(now()) @onUpdate(now()) @map("updated_at")

  deviceCredentialsId String            @unique
  deviceCredentials   DeviceCredentials @relation(fields: [deviceCredentialsId], references: [id])

  @@map("devices_sessions")
}

model Company {
  id      String @id @onCreate(uuid())
  name    String
  address String
  cpf     String
  tipoDoc Int    @map("tipo_doc")
  cpfCnpj String @unique @map("cpf_cnpj")
  cei     String

  registration String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @onCreate(now()) @onUpdate(now()) @map("updated_at")

  adminUsers AdminUser[]
  users      User[]

  @@map("companies")
}

model User {
  id             String  @id @onCreate(uuid())
  name           String
  pis            String  @unique
  cpf            String?
  code           String
  templatesCount Int     @map("templates_count")
  password       String
  rfid           String
  bars           String
  registration   String

  payrollNumber String?   @map("payroll_number")
  admissionDate DateTime? @map("admission_date")
  position      String?
  department    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @onCreate(now()) @onUpdate(now()) @map("updated_at")

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  adminUserId String?    @unique @map("admin_user_id")
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])

  punchRecords PunchRecord[]
  schedules    Schedule[]

  @@map("users")
}

model PunchRecord {
  id       String   @id @onCreate(uuid())
  pis      String
  datetime DateTime

  afdDatetime           DateTime? @map("afd_datetime")
  nsr                   Int?      @unique
  registrationType      String?   @map("registration_type")
  hexadecimalCheckDigit String?   @map("hexadecimal_check_digit")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @onCreate(now()) @onUpdate(now()) @map("updated_at")

  user User @relation(fields: [pis], references: [pis])

  @@map("punch_records")
}

model Schedule {
  id        String @id @onCreate(uuid())
  startDate Date   @map("start_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @onCreate(now()) @onUpdate(now()) @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  days ScheduleDay[]

  @@unique([userId, startDate])
  @@map("schedules")
}

model ScheduleDay {
  id      String @id @onCreate(uuid())
  weekday Int
  entry1  Int?   @map("entry_1")
  exit1   Int?   @map("exit_1")
  entry2  Int?   @map("entry_2")
  exit2   Int?   @map("exit_2")
  entry3  Int?   @map("entry_3")
  exit3   Int?   @map("exit_3")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @onCreate(now()) @onUpdate(now()) @map("updated_at")

  scheduleId String   @map("schedule_id")
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, weekday])
  @@map("schedules_days")
}
